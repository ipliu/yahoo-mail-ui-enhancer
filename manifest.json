{
  "manifest_version": 3,
  "name": "Yahoo Mail UI Enhancer",
  "version": "0.2.0",
  "description": "Focused, offline visual improvements for the Supported Mail Interface.",
  "icons": {
    "128": "assets/icon-128.png"
  },
  "permissions": ["storage"],
  "action": {
    "default_popup": "popup.html"
  },
  "host_permissions": ["https://mail.yahoo.com/*"],
  "content_scripts": [
    {
      "matches": ["https://mail.yahoo.com/*"],
      "css": ["src/sidebar-concealment.css"],
      "js": ["src/preferences.js", "src/page-controller.js"],
      "run_at": "document_idle"
    }
  ]
}
